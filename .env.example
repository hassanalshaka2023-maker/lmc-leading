# ============================================================
# LMC — example environment. Copy to .env and fill real values.
# .env is git-ignored. Never commit real secrets.
# ============================================================

# ---------- MongoDB ----------
# Local dev uses a free MongoDB Atlas M0 cluster (no local footprint):
#   mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/lmc_db?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/lmc_db?retryWrites=true&w=majority
# Production (Hostinger): mongodb://USER:PASS@HOST:27017/lmc_db?authSource=admin
#
# Offline fallbacks (both are large one-time downloads):
#   - `npm run db` in backend/  -> mongodb-memory-server, MONGO_URI=mongodb://127.0.0.1:27017/lmc_db
#   - docker compose up -d mongo -> uses the three vars below
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=changeme
MONGO_INITDB_DATABASE=lmc_db

# ---------- Backend ----------
NODE_ENV=development
BACKEND_PORT=3000
API_PREFIX=api

# Auth (generate strong random values for real environments)
JWT_ACCESS_SECRET=replace-with-64-char-random
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-with-different-64-char-random
JWT_REFRESH_TTL=7d

# Seed admin (created by `npm run seed` if no admin exists)
SEED_ADMIN_EMAIL=hassan@gmail.com
SEED_ADMIN_PASSWORD=12345678

# Forgot-password emails (Gmail): Google Account -> Security -> 2-Step
# Verification (must be on) -> App passwords -> generate one for "Mail".
# Leave blank to skip real sending — the reset code is logged instead.
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Rate limiting — THROTTLE_LIMIT is per visitor IP per THROTTLE_TTL seconds.
# A single home-page load makes ~12 API calls; keep this well above that.
THROTTLE_TTL=60
THROTTLE_LIMIT=120
AUTH_THROTTLE_LIMIT=5

# CORS — allowed frontend origin
CORS_ORIGIN=http://localhost:5173

# ---------- File storage ----------
STORAGE_DRIVER=local            # local | s3 (s3 not implemented in MVP)
STORAGE_LOCAL_DIR=./uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:3000/uploads
MAX_UPLOAD_MB=5

# ---------- Frontend (Vite — must be prefixed VITE_) ----------
VITE_API_BASE_URL=http://localhost:3000/api
VITE_DEFAULT_LOCALE=ar
