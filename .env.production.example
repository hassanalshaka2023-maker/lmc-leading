# ============================================================
# LMC — production environment for the VPS (backend + Nginx).
# The database is MongoDB Atlas (managed, external).
# Copy to .env.production ON THE SERVER and fill in real values.
# .env.production is git-ignored. Never commit it.
#
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
# ============================================================

# ---------- MongoDB Atlas ----------
# Atlas -> Database -> Connect -> Drivers -> copy the SRV string, then:
#   - replace <db_password> with the real DB-user password
#   - insert /lmc_db before the "?" (that is the database name; without it
#     Mongoose connects to the "test" database and the site looks empty)
#   - URL-encode any of  : / ? # [ ] @  appearing in the password
#     (e.g.  @ -> %40 ,  # -> %23 )
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/lmc_db?retryWrites=true&w=majority

# ---------- Backend ----------
API_PREFIX=api

# Generate each one separately, they MUST differ:
#   openssl rand -hex 48
JWT_ACCESS_SECRET=CHANGE_ME_64_plus_random_chars
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_64_plus_random_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Where the frontend lives. Comma-separated, no trailing slash.
# Include BOTH your custom domain and the vercel.app domain.
CORS_ORIGIN=https://lmc.example.com,https://lmc.vercel.app

# Public URL of the API host — used to build URLs for uploaded media.
# Media files live on the VPS disk, not in Atlas.
STORAGE_PUBLIC_BASE_URL=https://api.example.com/uploads
MAX_UPLOAD_MB=5

# Storage driver: "local" (VPS disk, above) or "cloudinary" (needed on hosts
# whose disk is wiped on restart, e.g. Render free). Cloudinary dashboard ->
# Settings -> API Keys.
STORAGE_DRIVER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Rate limiting — THROTTLE_LIMIT is per visitor IP per THROTTLE_TTL seconds.
# A single home-page load makes ~12 API calls; keep this well above that.
THROTTLE_TTL=60
THROTTLE_LIMIT=120
# Number of reverse-proxy hops in front of the API (Nginx or Render = 1).
# Without it the rate limiter sees every visitor as the proxy's single IP.
TRUST_PROXY=1
AUTH_THROTTLE_LIMIT=5

# ---------- Seed admin ----------
# Used only when no admin exists yet. Use a real address and a strong password.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=CHANGE_ME_strong_password

# ---------- Forgot-password email (optional) ----------
# Gmail app password. Leave blank to log reset codes instead of sending mail.
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
