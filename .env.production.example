# ============================================================
# LMC — production environment for the VPS.
# MongoDB, the API and the site run as containers here; the server's own
# Nginx terminates TLS and proxies to them.
# Copy to .env.production ON THE SERVER and fill in real values.
# .env.production is git-ignored. Never commit it.
#
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
# ============================================================

# ---------- MongoDB (container on this server) ----------
# Not exposed to the internet; only the API container can reach it.
# Generate the password with:  openssl rand -hex 24
MONGO_ROOT_USER=lmc_admin
MONGO_ROOT_PASSWORD=CHANGE_ME_random_password
MONGO_DB_NAME=lmc_db

# ---------- Ports published on 127.0.0.1 for Nginx ----------
# Change these only if something else on the server already uses them;
# deploy/nginx/lmc.conf must then be changed to match.
BACKEND_HOST_PORT=3001
FRONTEND_HOST_PORT=8080

# ---------- Backend ----------
API_PREFIX=api

# Generate each one separately, they MUST differ:
#   openssl rand -hex 48
JWT_ACCESS_SECRET=CHANGE_ME_64_plus_random_chars
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_64_plus_random_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Where the site lives. Same origin as the API, so this is just the domain.
# No trailing slash.
CORS_ORIGIN=https://lmc.example.com

# Public URL for uploaded media. Files live on this server's disk.
STORAGE_PUBLIC_BASE_URL=https://lmc.example.com/uploads
MAX_UPLOAD_MB=5

# Rate limiting — THROTTLE_LIMIT is per visitor IP per THROTTLE_TTL seconds.
# A single home-page load makes ~12 API calls; keep this well above that.
THROTTLE_TTL=60
THROTTLE_LIMIT=120
AUTH_THROTTLE_LIMIT=5

# ---------- Seed admin ----------
# Used only when no admin exists yet. Use a real address and a strong password.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=CHANGE_ME_strong_password

# ---------- Forgot-password email (optional) ----------
# Gmail app password. Leave blank to log reset codes instead of sending mail.
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
